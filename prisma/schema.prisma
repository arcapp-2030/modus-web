datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  USER
  ADMIN
  MANAGER
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
}

// --------------------------------------------------------
// TABELAS DE AUTENTICAÇÃO E USUÁRIOS
// --------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  trips         Trip[]
  status        Status         @default(ACTIVE)
  avatarUrl     String?
  
  // Relacionamentos
  refreshTokens RefreshToken[]
  notifications Notification[]
  logs          AuditLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Trip {
  id          String          @id @default(uuid())
  title       String          // Ex: "Tóquio, Japão"
  destination String
  startDate   DateTime?
  endDate     DateTime?
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  itinerary   ItineraryItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ItineraryItem {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  title       String   // Ex: "Voo JL048 para Haneda"
  subtitle    String?  // Ex: "Embarque no terminal 3"
  type        String   // "flight", "hotel", "food", "tour"
  location    String?
  date        String?
  time        String?
  voucherFile String?  // URL ou caminho do arquivo/voucher armazenado
  createdAt   DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// --------------------------------------------------------
// SISTEMA DE NOTIFICAÇÕES (PWA / Push)
// --------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// --------------------------------------------------------
// LOGS DE AUDITORIA E ATIVIDADE
// --------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // ex: "USER_LOGIN", "UPDATE_SETTINGS"
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}