datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  USER
  ADMIN
  MANAGER
}

enum Status {
  ACTIVE
  INACTIVE
  PENDING
}

// --------------------------------------------------------
// TABELAS DE AUTENTICAÇÃO E USUÁRIOS
// --------------------------------------------------------

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  status        Status         @default(ACTIVE)
  avatarUrl     String?
  
  // Relacionamentos
  refreshTokens RefreshToken[]
  notifications Notification[]
  logs          AuditLog[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

// --------------------------------------------------------
// SISTEMA DE NOTIFICAÇÕES (PWA / Push)
// --------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

// --------------------------------------------------------
// LOGS DE AUDITORIA E ATIVIDADE
// --------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // ex: "USER_LOGIN", "UPDATE_SETTINGS"
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}